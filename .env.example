# HKM Audio System — environment template
# Copy to .env and adjust as needed.

# SQLite database for Prisma.
# Path is resolved relative to prisma/schema.prisma
DATABASE_URL=file:../db/custom.db

# Directory holding hkm-state.json (defaults to <repo>/db)
# HKM_DATA_DIR=

# WebSocket mini-service origin (defaults to http://127.0.0.1:3030)
# HKM_WS_SERVICE=
