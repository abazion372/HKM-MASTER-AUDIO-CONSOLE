{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HKM Audio System",
  "version": "0.2.1",
  "identifier": "church.hkm.audiosystem",
  "build": {
    "beforeDevCommand": "bun run dev:desktop",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run build && node scripts/prepare-desktop.mjs",
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": ["default", "local-server"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../.next/standalone": "next-server",
      "binaries": "binaries"
    },
    "shortDescription": "Church Audio Intelligence & DSP Console",
    "longDescription": "HKM Audio System — a 16-channel virtual sound console with WASAPI process-exclusion loopback, feedback analysis, gain staging intelligence and remote companion control for church audio teams.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {}
}
