{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "local-server",
  "description": "Grants Tauri IPC and updater access to the embedded local Next.js console server ports",
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://localhost:3000/*",
      "http://127.0.0.1:3000/*",
      "http://127.0.0.1:37741/*",
      "http://127.0.0.1:37742/*",
      "http://127.0.0.1:37743/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "updater:default"
  ]
}
