# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# runtime state (churns constantly in 24/7 operation; never commit)
/db/hkm-state.json
/db/*.db
/db/*.db-journal

# local tooling artifacts
tool-results/


# typescript
*.tsbuildinfo
next-env.d.ts
/local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# Tauri Windows desktop shell
/src-tauri/target/
/src-tauri/gen/
/src-tauri/binaries/*.exe
/release/
/app-icon.png

# uploaded screenshots / verification artifacts
/upload/
